{
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },

      // Swagger: the gateway fetches each service's OpenAPI JSON.
      // PathRemovePrefix turns /docs/products/openapi/v1.json into /openapi/v1.json before forwarding.
      "products-docs-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/docs/products/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/docs/products" } ]
      },
      "orders-docs-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/docs/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/docs/orders" } ]
      },
      "payments-docs-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/docs/payments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/docs/payments" } ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": { "primary": { "Address": "http://localhost:5101/" } }
      },
      "orders-cluster": {
        "Destinations": { "primary": { "Address": "http://localhost:5102/" } }
      },
      "payments-cluster": {
        "Destinations": { "primary": { "Address": "http://localhost:5103/" } }
      }
    }
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
