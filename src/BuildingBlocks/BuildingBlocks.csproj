<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared "building blocks" used by every microservice:
      - Contracts      : the messages services exchange over RabbitMQ
      - Messaging      : a small RabbitMQ publisher/consumer framework
      - Observability  : Serilog logging + correlation id propagation
      - Persistence    : database startup helper (wait-for-db + create schema)
      - Health         : liveness / readiness endpoints (used by Kubernetes probes)

    NOTE: In a large company, contracts are often shipped as a versioned NuGet package
    so teams can evolve independently. A project reference keeps this demo simple.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives us ASP.NET Core types (middleware, health checks, WebApplication) in a class library -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <!-- OpenAPI document generation + Swagger UI page -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

</Project>
