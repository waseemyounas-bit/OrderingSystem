# nginx has TWO jobs here:
#   1. Serve the Angular app (static files)
#   2. Reverse-proxy /api, /swagger and /docs to the API gateway
# The browser only ever talks to this one origin, so there's no CORS. Same idea as proxy.conf.json in development.
#
# ${API_GATEWAY_URL} is filled in from an environment variable when the container starts.

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ---- backend calls -> API gateway ----
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /swagger {
        proxy_pass ${API_GATEWAY_URL};
    }

    location /docs/ {
        proxy_pass ${API_GATEWAY_URL};
    }

    # ---- liveness/readiness probe target for Kubernetes ----
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ---- Angular files ----
    # Hashed bundles (main-ZM2AJCQJ.js) never change -> cache them for a long time
    location ~* \.(?:js|css|ico|png|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA FALLBACK: /orders/123 isn't a real file. Return index.html and let the Angular router
    # handle the URL; without this, refreshing the page on /orders/123 would give a 404.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
